# ===== DJANGO CORE =====
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1

# ===== DATABASE =====
# Production (Render/Neon): set DATABASE_URL
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Local (docker/dev): used when DATABASE_URL is not set
DB_NAME=tienda_pope
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# ===== CORS / CSRF (frontend origins) =====
# Local
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Production example:
# CORS_ALLOWED_ORIGINS=https://tu-sitio.netlify.app
# CSRF_TRUSTED_ORIGINS=https://tu-sitio.netlify.app

# ===== SECURITY (prod, cuando DEBUG=False) =====
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ===== LOGGING =====
LOG_LEVEL=INFO

# ===== MEDIA / R2 (recomendado en Render: disco efímero) =====
USE_R2_STORAGE=False
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_HOST=cdn.tu-dominio.com

# ===== FRONTEND (referencia) =====
# VITE_API_URL se configura en frontend/.env o en Netlify (build-time)
FRONTEND_URL=http://localhost:5173
