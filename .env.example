# ===== DJANGO CORE SETTINGS =====
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,popé.example.com

# ===== DATABASE CONFIGURATION =====
# Production: Use DATABASE_URL for Neon PostgreSQL (includes sslmode=require)
# Example: postgresql://user:password@host.neon.tech/database?sslmode=require
# CRITICAL: Neon requires sslmode=require in connection string
DATABASE_URL=postgresql://user:password@db:5432/tienda_pope

# Development: Use individual DB_* variables (Docker Compose)
# These are only used when DATABASE_URL is not set
DB_ENGINE=django.db.backends.postgresql
DB_NAME=tienda_pope
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# ===== SECURITY SETTINGS (PRODUCTION ONLY) =====
# Force HTTPS redirect (set to False only in development)
SECURE_SSL_REDIRECT=True

# HSTS (HTTP Strict Transport Security) - 1 year = 31536000 seconds
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ===== CORS & CSRF SETTINGS =====
# Comma-separated list of allowed origins for cross-origin requests
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Comma-separated list of origins allowed for CSRF validation
# Should include your frontend domain in production
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ===== JWT SETTINGS =====
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# ===== CLOUDFLARE R2 STORAGE (for media files in production) =====
# Enable R2 storage instead of local filesystem
USE_R2_STORAGE=False

# R2 Configuration (get from Cloudflare API token creation)
# R2_ACCOUNT_ID: Found in Cloudflare dashboard (Settings → Account ID)
# R2_ACCESS_KEY_ID: Generated when creating API token
# R2_SECRET_ACCESS_KEY: Generated when creating API token (save it immediately, won't be shown again)
# R2_BUCKET_NAME: Created in Cloudflare R2 → Create bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# R2_PUBLIC_HOST: The public hostname for your R2 bucket (without https://)
# - Production: use a custom domain connected to the bucket (e.g., cdn.pope.com.ar)
# - Testing: use the public R2 URL from Cloudflare dashboard (e.g., pub-<hash>.r2.dev)
# Example: R2_PUBLIC_HOST=cdn.pope.com.ar
# Example: R2_PUBLIC_HOST=pub-abc123def456.r2.dev
R2_PUBLIC_HOST=

# ===== CELERY (optional for async tasks) =====
CELERY_BROKER_URL=redis://redis:6379/0

# ===== EMAIL SETTINGS (optional) =====
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ===== WHATSAPP INTEGRATION =====
WHATSAPP_NUMBER=+54 9 376 XXX-XXXX
WHATSAPP_MESSAGE_TEMPLATE=Hola, quiero consultar por el pedido #{order_number}...

# ===== SHOP SETTINGS =====
SHOP_NAME=Popé
SHOP_EMAIL=info@pope.com.ar

# ===== LOGGING =====
LOG_LEVEL=INFO

# ===== FRONTEND CONFIGURATION =====
FRONTEND_URL=http://localhost:5173

# ===== ADMIN PANEL =====
ADMIN_SITE_TITLE=Popé - Panel de Administración
